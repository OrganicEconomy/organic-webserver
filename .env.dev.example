NODE_ENV=dev

# SQLite is the default; data lands in ./data/organic.sqlite
# (override with DB_STORAGE=path/to/file.sqlite).
DB_DIALECT=sqlite

NODE_LOCAL_PORT=6868

# Generate each key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORGANIC_SECRET_KEY=<64 hex characters>
ORGANIC_MASTER_KEY=<another 64 hex characters>
ORGANIC_SERVER_NAME=Serveur de dev
